    "780a237a-9d61-4a53-86f0-fdce8fdd6f7f": {
      "id": "780a237a-9d61-4a53-86f0-fdce8fdd6f7f",
      "name": "Login",
      "method": "POST",
      "url": "{{base_url}}/users/login",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": "{\n  \"email\": \"admin@practicesoftwaretesting.com\",\n  \"password\": \"welcome01\"\n}"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.variables.set(\"access_token\", String(json.access_token));",
      "hookType": "beforeAll",
      "schema": "{\n  \"title\": \"TokenResponse\",\n  \"properties\": {\n    \"access_token\": {\n      \"description\": \"\",\n      \"type\": \"string\",\n      \"example\": \"super-secret-token\"\n    },\n    \"token_type\": {\n      \"description\": \"\",\n      \"type\": \"string\",\n      \"example\": \"Bearer\"\n    },\n    \"expires_in\": {\n      \"description\": \"\",\n      \"type\": \"number\",\n      \"example\": 120\n    }\n  },\n  \"type\": \"object\"\n}"
    },
    "2fad6b10-52af-4a17-82c0-44043ad222ac": {
      "id": "2fad6b10-52af-4a17-82c0-44043ad222ac",
      "name": "Create brand",
      "method": "POST",
      "url": "{{base_url}}/brands",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": "{\n  \"name\": \"{{faker.company.name()}}\",\n  \"slug\": \"{{faker.\"\n}"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.variables.set(\"id\", String(json.id));",
      "contract": {
        "statusCode": 201,
        "headers": [
          {
            "key": "content-type",
            "value": "application/json",
            "required": true
          }
        ],
        "bodySchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"slug\": {\n      \"type\": \"string\"\n    },\n    \"id\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"name\",\n    \"slug\",\n    \"id\"\n  ]\n}"
      },
      "schema": "{\n  \"title\": \"BrandResponse\",\n  \"properties\": {\n    \"id\": {\n      \"type\": \"integer\"\n    },\n    \"name\": {\n      \"type\": \"string\",\n      \"example\": \"new brand\"\n    },\n    \"slug\": {\n      \"type\": \"string\",\n      \"example\": \"new-brand\"\n    }\n  },\n  \"type\": \"object\"\n}"
    },
    "1ae5ccfb-f204-444e-9108-e1b1a2abfd27": {
      "id": "1ae5ccfb-f204-444e-9108-e1b1a2abfd27",
      "name": "Read brand",
      "method": "GET",
      "url": "{{base_url}}/brands/{{id}}",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": ""
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test(\"Status is 200\", function() {\n  sp.expect(sp.response.code).to.equal(200);\n});\n\n\nsp.test(\"JSON field equals value\", function() {\n  sp.expect(json.id).to.equal(\"{{id}}\");\n});"
    },
    "bebce49e-e5df-43f1-9029-206e94954c3b": {
      "id": "bebce49e-e5df-43f1-9029-206e94954c3b",
