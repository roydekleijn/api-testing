    "028226d7-defa-4907-87fd-5687800360c3": {
      "id": "028226d7-defa-4907-87fd-5687800360c3",
      "name": "New Request",
      "method": "POST",
      "url": "http://www.dneonline.com/calculator.asmx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=utf-8",
          "enabled": true
        }
      ],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "soap",
        "soap": {
          "wsdlUrl": "http://www.dneonline.com/calculator.asmx?WSDL",
          "envelope": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope\n  xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"\n  xmlns:tns=\"http://tempuri.org/\">\n  <soap:Header/>\n  <soap:Body>\n    <tns:Add>\n      <tns:intA><!-- int --></tns:intA>\n      <tns:intB><!-- int --></tns:intB>\n    </tns:Add>\n  </soap:Body>\n</soap:Envelope>",
          "operationName": "Add",
          "soapVersion": "1.1",
          "binding": "CalculatorSoap",
          "soapAction": "http://tempuri.org/Add"
        }
      },
      "protocol": "soap",
      "postRequestScript": "sp.test('soap:Body > DivideResponse > DivideResult equals \"2\"', function() {\n  sp.expect(sp.response.xmlText(\"soap:Body > DivideResponse > DivideResult\")).to.equal(\"2\");\n});"
    },
