    "7229e7e0-cfe8-4b61-8d03-c0955df1adca": {
      "id": "7229e7e0-cfe8-4b61-8d03-c0955df1adca",
      "name": "login",
      "method": "POST",
      "url": "{{baseUrl}}/users/login",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "json",
        "json": "{\n  \"email\": \"customer@practicesoftwaretesting.com\",\n  \"password\": \"welcome01\"\n}"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.variables.set(\"access_token\", String(json.access_token));"
    },
    "4a0aae06-bcdc-436f-b477-e4f9d89c72a8": {
      "id": "4a0aae06-bcdc-436f-b477-e4f9d89c72a8",
      "name": "get user info",
      "method": "GET",
      "url": "{{baseUrl}}/users/me",
      "headers": [],
      "params": [],
      "auth": {
        "type": "bearer",
        "token": "{{access_token}}"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('first_name equals \"Jane\"', function() {\n  sp.expect(json.first_name).to.equal(\"Jane\");\n});\n\nsp.test('last_name equals \"Doe\"', function() {\n  sp.expect(json.last_name).to.equal(\"Doe\");\n});\n\nsp.test('address.street equals \"Test street 98\"', function() {\n  sp.expect(json.address.street).to.equal(\"Test street 98\");\n});\n\nsp.variables.set(\"userId\", String(json.id));"
    },
    "ea2ce770-431c-4f49-93c4-e400974a594c": {
      "id": "ea2ce770-431c-4f49-93c4-e400974a594c",
      "name": "get products",
      "method": "GET",
      "url": "{{baseUrl}}/products",
      "headers": [],
      "params": [],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none"
      },
      "postRequestScript": "const json = sp.response.json();\n\nconst matches = sp.jsonPath(json, '$.data[?(@.name==\"Combination Pliers\")].id');\nsp.variables.set(\"productId\", String(matches[0] ?? ''));"
    },
    "28d43006-99ad-4f64-8801-469956b88a42": {
