        "token": "{{access_token}}"
      },
      "body": {
        "mode": "json",
        "json": "{\n  \"billing_street\": \"Verboomring\",\n  \"billing_city\": \"Hulsel\",\n  \"billing_state\": \"Noord-Holland\",\n  \"billing_country\": \"NL\",\n  \"billing_postal_code\": \"3453nt\",\n  \"payment_method\": \"cash-on-delivery\",\n  \"cart_id\": \"{{cartId}}\",\n  \"payment_details\": {}\n}"
      },
      "postRequestScript": "const json = sp.response.json();\n\nsp.test('invoice_number exists', function() {\n  sp.expect(json.invoice_number).to.not.be.oneOf([null, undefined]);\n});\n\nsp.test('user_id equals \"{{userId}}\"', function() {\n  sp.expect(json.user_id).to.equal(\"{{userId}}\");\n});"
    }
