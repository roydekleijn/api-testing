              },\n                    \"co2_rating\": {\n                      \"type\": \"string\",\n                      \"example\": \"A\"\n                    },\n                    \"is_eco_friendly\": {\n                      \"type\": \"boolean\",\n                      \"example\": true\n                    },\n                    \"brand\": {\n                      \"title\": \"BrandResponse\",\n                      \"properties\": {\n                        \"id\": {\n                          \"type\": \"string\"\n                        },\n                        \"name\": {\n                          \"type\": \"string\",\n                          \"example\": \"new brand\"\n                        },\n                        \"slug\": {\n                          \"type\": \"string\",\n                          \"example\": \"new-brand\"\n                        }\n                      },\n                      \"type\": \"object\"\n                    },\n                    \"category\": {\n                      \"title\": \"CategoryResponse\",\n                      \"properties\": {\n                        \"id\": {\n                          \"type\": \"string\"\n                        },\n                        \"parent_id\": {\n                          \"type\": [\n                            \"string\",\n                            \"null\"\n                          ]\n                        },\n                        \"name\": {\n                          \"type\": \"string\",\n                          \"example\": \"new category\"\n                        },\n                        \"slug\": {\n                          \"type\": \"string\",\n                          \"example\": \"new-category\"\n                        },\n                        \"sub_categories\": {\n                          \"type\": \"array\",\n                          \"items\": {}\n                        }\n                      },\n                