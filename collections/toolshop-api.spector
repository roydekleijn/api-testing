    "f4cc9e5f-239e-42e9-939a-45780701ad2f": {
      "id": "f4cc9e5f-239e-42e9-939a-45780701ad2f",
      "name": "Live sales feed over Server-Sent Events (SSE)",
      "method": "GET",
      "url": "{{baseUrl}}/sales-stream",
      "headers": [],
      "params": [
        {
          "key": "limit",
          "value": "5",
          "enabled": false,
          "description": "Maximum number of sale events to emit before closing (1-50, default 5).\n     *              Fewer may be emitted if all products sell out first."
        },
        {
          "key": "interval",
          "value": "500",
          "enabled": false,
          "description": "Base delay between events in milliseconds (100-3000, default 500).\n     *              Within a burst the gaps are ~12-35% of this; between bursts ~90-260%, so the\n     *              feed reads as organic rather than fixed-rate."
        },
        {
          "key": "seed",
          "value": "42",
          "enabled": false,
          "description": "Seed the random generator for a deterministic sequence."
        }
      ],
      "auth": {
        "type": "none"
      },
      "body": {
        "mode": "none"
      },
      "description": "Streams a finite run of simulated purchases built from real in-stock\n     *          products, using the `text/event-stream` protocol. Named events are emitted in\n     *          order: one `open`, then `sale` events (with an occasional `heartbeat`), then a\n     *          final `end`. Each `sale` carries an incrementing SSE `id`, so a reconnecting\n     *          client can send `Last-Event-ID` to resume numbering. Provide `seed` for a\n     *          deterministic, repeatable sequence.\n     *          The feed is modelled to feel alive: sales are **popularity-weighted** (cheaper,\n     *          consumable items sell far more often than expensive ones), arrive in **bursts and\n     *          lulls** rather than at a fixed rate, and are **stock-aware** - each sale draws down\n     *          a per-stream stock counter (`remaining_stock`), quantities are capped to what is\n     *          left, a product is retired once it hits zero (`sold_out: true`), and if everything\n     *          sells out a `sold-out` event is emitted and the stream ends early.\n     *          Note: Swagger UI and most API clients do not render SSE incrementally - they\n     *          buffer the whole response and only show it once the stream closes, so the call\n     *          appears to hang for its full duration. Consume it with an `EventSource` (browser)\n     *          to see events live, or keep `limit`/`interval` small for quick manual tests.",
      "meta": {
        "tags": [
          "Stream"
        ]
      }
    },
    "d9ff33aa-2cb2-4a1b-ba36-afb381d6cf39": {
      "id": "d9ff33aa-2cb2-4a1b-ba36-afb381d6cf39",
