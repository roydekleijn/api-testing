      "description": "Retrieve all users",
      "meta": {
        "tags": [
          "User"
        ]
      },
      "schema": "{\n  \"title\": \"PaginatedUserResponse\",\n  \"properties\": {\n    \"current_page\": {\n      \"type\": \"integer\",\n      \"example\": 1\n    },\n    \"data\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"title\": \"UserResponse\",\n        \"properties\": {\n          \"first_name\": {\n            \"type\": \"string\",\n            \"example\": \"John\"\n          },\n          \"last_name\": {\n            \"type\": \"string\",\n            \"example\": \"Doe\"\n          },\n          \"address\": {\n            \"properties\": {\n              \"street\": {\n                \"type\": \"string\",\n                \"example\": \"Street 1\"\n              },\n              \"house_number\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ],\n                \"example\": \"12\"\n              },\n              \"city\": {\n                \"type\": \"string\",\n                \"example\": \"City\"\n              },\n              \"state\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ],\n                \"example\": \"State\"\n              },\n              \"country\": {\n                \"type\": \"string\",\n                \"example\": \"Country\"\n              },\n              \"postal_code\": {\n                \"type\": [\n                  \"string\",\n                  \"null\"\n                ],\n                \"example\": \"1234AA\"\n              }\n            },\n            \"type\": \"object\"\n          },\n          \"phone\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"example\": \"0987654321\"\n          },\n          \"dob\": {\n            \"type\": \"string\",\n            \"example\": \"1970-01-01\"\n          },\n          \"email\": {\n            \"type\": \"string\",\n            \"example\": \"john@doe.example\"\n          },\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"provider\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ]\n          },\n          \"totp_enabled\": {\n            \"type\": \"boolean\"\n          },\n          \"enabled\": {\n            \"type\": \"boolean\"\n          },\n          \"failed_login_attempts\": {\n            \"type\": [\n              \"integer\",\n              \"null\"\n            ]\n          },\n          \"created_at\": {\n            \"type\": \"string\",\n            \"example\": \"2022-08-01 08:24:56\"\n          }\n        },\n        \"type\": \"object\"\n      }\n    },\n    \"from\": {\n      \"type\": \"integer\",\n      \"example\": 1\n    },\n    \"last_page\": {\n      \"type\": \"integer\",\n      \"example\": 1\n    },\n    \"per_page\": {\n      \"type\": \"integer\",\n      \"example\": 1\n    },\n    \"to\": {\n      \"type\": \"integer\",\n      \"example\": 1\n    },\n    \"total\": {\n      \"type\": \"integer\",\n      \"example\": 1\n    }\n  },\n  \"type\": \"object\"\n}"
    },
